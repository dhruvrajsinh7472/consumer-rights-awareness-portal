# Consumer Rights Awareness Portal - Environment Configuration Template
# For local development: copy this file to .env and adjust variables as needed.
# For Render deployment: configure these environment variables in Render Dashboard -> Environment.

# Flask environment ('production' for Render, 'development' for local)
FLASK_ENV=production

# Application Secret Key (generate a secure random 32-character string for production)
SECRET_KEY=

# Production Database (Supabase PostgreSQL)
# Copy the URI from Supabase Dashboard -> Connect -> Session pooler (Port 5432, Mode: Session)
# Format: postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Local Development Database Fallback (used when DATABASE_URL is not set)
DATABASE_PATH=instance/consumer_rights.db

# Web Server Configuration (configured dynamically by Render)
PORT=5000
HOST=0.0.0.0

# Optional Administrative Dashboard Credentials
# (If not configured, the administrative review routes at /admin remain safely disabled)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
